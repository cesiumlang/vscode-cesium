#!/usr/bin/env bash
# direnv: Node.js for building the extension, the version in .node-version, through fnm
if has fnm; then
  eval "$(fnm env --shell bash)"
  fnm use --install-if-missing --silent-if-unchanged
fi

# the Zig of the Cesium devkit, for the build steps (zig build), from the
# compiler's checkout next to this one in cesium-workspace
if [ -d ../cesium-src/.devkit/zig ]; then
  PATH_add ../cesium-src/.devkit/zig
fi
