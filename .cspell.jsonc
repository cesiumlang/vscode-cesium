{
  "version": "0.2",
  "ignorePaths": [
    ".cspell.json*",
    ".cspell/**",
    ".git/**",
    "*.code-workspace",
    ".gitignore",
    ".local-gitignore",
    "node_modules/**",
    // generated in cesiumlang/cesiumlang.org, fetched by tools/fetch-skill.sh
    "agent-plugin/skills/cesium-language/**",
    "package-lock.json",
    "*.vsix",
    "dist/**",
    "out/**",
    "grammar/**",
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": ".vscode/ltex.dictionary.en-US.txt",
      "addWords": true
    }
  ],
  "dictionaries": [
    "bash",
    "win32",
    "scientific-terms-us",
    "project-words"
  ],
  "allowCompoundWords": true,
  "ignoreWords": [],
  "ignoreRegExpList": [],
}
